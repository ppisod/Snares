<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <RollForward>Major</RollForward>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Icon.ico" />
        <None Remove="Icon.bmp" />
        <None Update="Game\Beatmaps\ez.json">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Icon.ico">
            <LogicalName>Icon.ico</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Icon.bmp">
            <LogicalName>Icon.bmp</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MonoGame.Extended" Version="5.0.2" />
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
        <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\ppilib\ppilib.csproj" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Content\Images\RhythmObjects\Snares\" />
      <Folder Include="Content\Vector\" />
      <Folder Include="Game\Node\" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="Content\Vector\Snare.svg" />
    </ItemGroup>
    <ItemGroup>
      <Compile Update="Game\Screens\TitleScreen.cs">
        <DependentUpon>Screen.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\Screens\BeatmapSelectorScreen.cs">
        <DependentUpon>Screen.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\Screens\Effects\IContinuousTweenSelector.cs">
        <DependentUpon>PointerContinuousTweener.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\Screens\TitleSequences.cs">
        <DependentUpon>TitleScreen.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\Screens\TitleInput.cs">
        <DependentUpon>TitleScreen.cs</DependentUpon>
      </Compile>
    </ItemGroup>
    <Target Name="RestoreDotnetTools" BeforeTargets="CollectPackageReferences">
        <Message Text="Restoring dotnet tools (this might take a while depending on your internet speed and should only happen upon building your project for the first time, or after upgrading MonoGame, or clearing your nuget cache)" Importance="High" />
        <Exec Command="dotnet tool restore" />
    </Target>
</Project>